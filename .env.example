# Copy to .env and fill in. Never commit the real .env.

# Databricks workspace URL and a personal access token (or service principal token)
DATABRICKS_HOST=https://adb-0000000000000000.0.azuredatabricks.net
DATABRICKS_TOKEN=

# Unity Catalog location for raw uploads and tables
AXLE_CATALOG=main
AXLE_SCHEMA=axlestream
AXLE_VOLUME=raw_telemetry

# Optional: where Auto Loader / streaming checkpoints live (defaults to <volume>/_checkpoints)
AXLE_CHECKPOINT_ROOT=

# Latency SLO used by the gold diagnostics (milliseconds)
AXLE_LATENCY_BUDGET_MS=10
